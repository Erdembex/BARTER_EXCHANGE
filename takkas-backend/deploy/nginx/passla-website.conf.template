server {
    listen 80;
    server_name __ROOT_DOMAIN__;

    root /var/www/passla/website;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /gizlilik {
        return 301 /gizlilik.html;
    }

    location = /destek {
        return 301 /destek.html;
    }
}
