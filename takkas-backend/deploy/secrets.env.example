# Production secrets sablonu — doldur, git'e ekleme
# Sunucuda: sudo bash deploy/scripts/apply-production-secrets.sh secrets.env

STORAGE_PROVIDER=s3
UPLOAD_DIR=/var/takkas/uploads

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bex-media-prod
AWS_S3_REGION=eu-central-1

SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=noreply@passla.com.tr

ADMIN_SEED_ENABLED=false
