# BEX ortam değişkenleri (opsiyonel — çoğu adım için gerekmez)

# Spring Boot REST API (Axios)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.105:8080

# Expo push bildirimleri — `npx eas init` sonrası project id
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# App Check — yalnızca yayına çıkmadan önce (Adım 3)
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Web App Check (reCAPTCHA v3)
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Demo veriyi kapatıp canlı Firestore kullanmak için (ileri seviye)
# EXPO_PUBLIC_USE_DEMO_DATA=false
