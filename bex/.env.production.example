# BEX Mobil — Production Environment
# EAS Secrets ile kullan (git'e ekleme):
#   eas secret:create --name EXPO_PUBLIC_API_BASE_URL --value https://api.bex.app

# Spring Boot REST API (HTTPS zorunlu production'da)
EXPO_PUBLIC_API_BASE_URL=https://api.bex.app

# EAS project — npx eas init sonrası doldurulur
EXPO_PUBLIC_EAS_PROJECT_ID=

# Firebase (production config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check — production'da debug token KULLANMA
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Demo modu kapalı
EXPO_PUBLIC_USE_DEMO_DATA=false
