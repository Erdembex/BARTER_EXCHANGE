{
  "expo": {
    "name": "BEX",
    "slug": "bex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bex",
    "description": "Görev yap, ödül kazan. BEX ile işletmelerden görev al, tamamla ve kupon kazan.",
    "primaryColor": "#7C3AED",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bex.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BEX, görev teslimi için fotoğraf seçmeni sağlar.",
        "NSCameraUsageDescription": "BEX, görev teslimi ve kupon QR okuma için kamerayı kullanır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.bex.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BEX, kupon QR kodlarını okutmak için kameraya erişim ister."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appCheckDebugToken": "",
      "privacyPolicyUrl": "https://bex.app/gizlilik"
    }
  }
}
