{
  "expo": {
    "name": "BEX",
    "slug": "bex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bex",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bex.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.bex.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BEX, kupon QR kodlarını okutmak için kameraya erişim ister."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
